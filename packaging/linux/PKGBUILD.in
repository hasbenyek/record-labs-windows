# Maintainer: Record Labs <hasbenyek@users.noreply.github.com>
# Generated by packaging/linux/package.sh; publish to the AUR as "record-labs-bin".
pkgname=record-labs-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Record Labs desktop music player"
arch=('x86_64')
url="https://github.com/hasbenyek/record-labs-windows"
license=('custom')
depends=('alsa-lib' 'libpulse' 'libx11' 'libxext' 'libxi' 'libxrender' 'libxtst' 'libxcb' 'libglvnd' 'fontconfig' 'freetype2' 'harfbuzz' 'fribidi' 'glib2' 'dbus' 'libdrm' 'zlib' 'xdg-utils')
provides=('record-labs')
conflicts=('record-labs')
options=('!strip' '!debug')
source=("https://github.com/hasbenyek/record-labs-windows/releases/download/v${pkgver}/record-labs-${pkgver}-linux-x86_64.tar.xz")
sha256sums=('@SHA256@')

package() {
  cp -a "${srcdir}/opt" "${pkgdir}/"
  cp -a "${srcdir}/usr" "${pkgdir}/"
  # Updates come from the AUR on Arch, not from the in-app updater.
  echo aur > "${pkgdir}/opt/record-labs/lib/app/package-type"
}
